{
  "name": "automation-exercise-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test tests/api tests/ui --project=chromium",
    "test:ui:dev": "TEST_ENV=dev playwright test tests/ui --project=chromium",
    "test:ui:test": "TEST_ENV=test playwright test tests/ui --project=chromium",
    "verify": "npm run check && npm test",
    "test:api:dev": "TEST_ENV=dev playwright test tests/api/verify-login.spec.ts --project=chromium",
    "test:api:test": "TEST_ENV=test playwright test tests/api/verify-login.spec.ts --project=chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://redheart76@github.com/redheart76/automation-exercise-tests.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/redheart76/automation-exercise-tests/issues"
  },
  "homepage": "https://github.com/redheart76/automation-exercise-tests#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  }
}
